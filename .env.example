# ---------------------------------------------------------------------------
# Modèle de configuration — COPIEZ CE FICHIER EN `.env`, PUIS RENSEIGNEZ-LE.
#
#     copy .env.example .env      (Windows)
#
# ⚠️ NE PLACEZ JAMAIS VOTRE CLÉ DANS CE FICHIER.
#    Il sert de gabarit et n'est volontairement PAS ignoré par git.
#
# Collez UNIQUEMENT le jeton d'accès personnel après « CDSAPI_KEY= ».
# PAS le bloc complet « url: ... / key: ... » : une seule valeur par ligne.
#
# Le jeton se récupère sur https://cds.climate.copernicus.eu/user
# (section « Set up the CDS API personal access token »).
# ---------------------------------------------------------------------------

CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=colllez-ici-votre-jeton-d-acces-personnel
